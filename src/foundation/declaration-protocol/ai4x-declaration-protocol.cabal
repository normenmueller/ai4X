cabal-version: 3.12

name: ai4x-declaration-protocol
version: 0.1.0.0
synopsis: Deterministic declaration transport contracts for ai4X
description:
  Closed versioned values, canonical codecs, and Generation identity validation.
homepage: https://github.com/normenmueller/ai4X
bug-reports: https://github.com/normenmueller/ai4X/issues
license: Apache-2.0
license-file: LICENSE
author: ai4X contributors
maintainer: ai4X contributors
category: Development
build-type: Simple

common language-and-warnings
  default-language: GHC2024
  ghc-options: -Wall

library
  import: language-and-warnings
  exposed-modules: AI4X.DeclarationProtocol
  other-modules:
      AI4X.DeclarationProtocol.Internal.Json
      AI4X.DeclarationProtocol.Internal.Protocol
  hs-source-dirs: src
  build-depends:
      ai4x-core >=0.1 && <0.2
    , base ==4.20.2.0
    , bytestring >=0.12.2 && <0.13
    , containers >=0.7 && <0.8
    , text >=2.1.3 && <2.2

test-suite ai4x-declaration-protocol-test
  import: language-and-warnings
  type: exitcode-stdio-1.0
  main-is: Main.hs
  other-modules:
      AI4X.DeclarationProtocol.CodecTest
      AI4X.DeclarationProtocol.ContractTest
      AI4X.DeclarationProtocol.Fixture
      AI4X.DeclarationProtocol.ValidationTest
  hs-source-dirs: tst
  build-depends:
      ai4x-core >=0.1 && <0.2
    , ai4x-declaration-protocol
    , base ==4.20.2.0
    , bytestring >=0.12.2 && <0.13
    , text >=2.1.3 && <2.2
