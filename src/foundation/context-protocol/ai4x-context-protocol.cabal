cabal-version: 3.12

name: ai4x-context-protocol
version: 0.1.0.0
synopsis: Closed host-neutral context transport contracts for ai4X
description:
  Versioned context references, inert transport values, and host-neutral ports.
homepage: https://github.com/normenmueller/ai4X
bug-reports: https://github.com/normenmueller/ai4X/issues
license: Apache-2.0
license-file: LICENSE
author: ai4X contributors
maintainer: ai4X contributors
category: Development
build-type: Simple

common language-and-warnings
  default-language: GHC2024
  ghc-options: -Wall

library
  import: language-and-warnings
  exposed-modules: AI4X.ContextProtocol
  other-modules:
      AI4X.ContextProtocol.Internal.Port
      AI4X.ContextProtocol.Internal.Reference
      AI4X.ContextProtocol.Internal.Value
  hs-source-dirs: src
  build-depends:
      ai4x-core >=0.1 && <0.2
    , base ==4.20.2.0
    , text >=2.1.3 && <2.2

test-suite ai4x-context-protocol-test
  import: language-and-warnings
  type: exitcode-stdio-1.0
  main-is: Main.hs
  other-modules:
      AI4X.ContextProtocol.PortTest
      AI4X.ContextProtocol.ReferenceTest
      AI4X.ContextProtocol.ValueTest
  hs-source-dirs: tst
  build-depends:
      ai4x-context-protocol
    , ai4x-core >=0.1 && <0.2
    , base ==4.20.2.0
    , text >=2.1.3 && <2.2
